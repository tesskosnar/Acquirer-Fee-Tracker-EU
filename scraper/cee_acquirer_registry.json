    {"name":"Peníze.cz","url":"https://www.penize.cz/","use":"Czech-market discovery and historical leads only"}
  ],
  "roles": {
    "acquiring_bank": "Bank contracting with and settling card transactions for the merchant.",
    "direct_acquirer": "Non-bank or payment-institution acquirer contracting with the merchant.",
    "acquirer_sales_channel": "Bank or brand distributing an acquiring service whose actual provider is named separately; not counted as another acquiring network.",
    "full_service_psp": "PSP offering the merchant a bundled acceptance price; secondary to acquirers.",
    "gateway_or_processor": "Technical gateway/processor without a standalone all-in acquiring offer; excluded from rate comparison unless the acquiring component is explicitly included."
